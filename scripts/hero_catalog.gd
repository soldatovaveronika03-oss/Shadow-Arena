static func build_model(data: Dictionary) -> Node3D:
	var root := Node3D.new()
	root.name = str(data.name)
	var c: Color = data.color
	var armor := _mat(c, 0.48, 0.18)
	var dark := _mat(c.darkened(0.62), 0.72, 0.0)
	var glow := _mat(c.lightened(0.18), 0.25, 0.7)
	_part(root, CapsuleMesh.new(), Vector3(0,1.05,0), Vector3(0.78,1.0,0.62), armor)
	_part(root, SphereMesh.new(), Vector3(0,2.0,0), Vector3(0.62,0.62,0.62), armor)
	_part(root, BoxMesh.new(), Vector3(-0.58,1.22,0), Vector3(0.42,0.65,0.62), dark)
	_part(root, BoxMesh.new(), Vector3(0.58,1.22,0), Vector3(0.42,0.65,0.62), dark)
	_part(root, CylinderMesh.new(), Vector3(-0.25,0.35,0), Vector3(0.3,0.75,0.34), dark)
	_part(root, CylinderMesh.new(), Vector3(0.25,0.35,0), Vector3(0.3,0.75,0.34), dark)
	_part(root, SphereMesh.new(), Vector3(0,2.08,-0.34), Vector3(0.18,0.12,0.08), glow)
	_part(root, BoxMesh.new(), Vector3(0,1.28,-0.38), Vector3(0.42,0.22,0.08), glow)
	for side in [-1.0,1.0]:
		_part(root, SphereMesh.new(), Vector3(side*0.58,1.65,0), Vector3(0.48,0.42,0.48), glow)
		_part(root, CylinderMesh.new(), Vector3(side*0.68,0.28,0), Vector3(0.18,0.4,0.18), armor)
	_part(root, PrismMesh.new(), Vector3(0,2.55,0), Vector3(0.42,0.5,0.42), glow)
	_part(root, TorusMesh.new(), Vector3(0,0.08,0), Vector3(1.25,1.25,1.25), glow)
	var weapon := BoxMesh.new()
	weapon.size = Vector3(0.16,1.5,0.22)
	_part(root, weapon, Vector3(0.95,1.25,-0.1), Vector3.ONE, glow)
	return root

static func _mat(color: Color, rough: float, emission: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.roughness = rough
	m.metallic = 0.35
	if emission > 0.0:
		m.emission_enabled = true
		m.emission = color * emission
	return m

static func _part(root: Node3D, mesh: Mesh, pos: Vector3, scale_value: Vector3, material: Material) -> void:
	var item := MeshInstance3D.new()
	item.mesh = mesh
	item.position = pos
	item.scale = scale_value
	item.material_override = material
	root.add_child(item)
